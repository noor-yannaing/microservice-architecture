{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api-gateway",
        "namespace": "commerce"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "api-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api-gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "api-gateway",
                "image": "commerce/api-gateway:local",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 9000
                  }
                ],
                "env": [
                  {
                    "name": "INTERNAL_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "commerce-local",
                        "key": "INTERNAL_TOKEN"
                      }
                    }
                  },
                  {
                    "name": "INVENTORY_URL",
                    "value": "http://inventory-service:8082"
                  },
                  {
                    "name": "JWT_JWK_SET_URI",
                    "value": "http://keycloak:8080/realms/commerce/protocol/openid-connect/certs"
                  },
                  {
                    "name": "ORDER_URL",
                    "value": "http://order-service:8081"
                  },
                  {
                    "name": "OTLP_ENDPOINT",
                    "value": "http://tempo:4318/v1/traces"
                  },
                  {
                    "name": "PRODUCT_URL",
                    "value": "http://product-service:8080"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1Gi"
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9000
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9000
                  },
                  "periodSeconds": 15
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9000
                  },
                  "periodSeconds": 10
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "api-gateway",
        "namespace": "commerce"
      },
      "spec": {
        "selector": {
          "app": "api-gateway"
        },
        "ports": [
          {
            "name": "tcp-9000",
            "port": 9000,
            "targetPort": 9000
          }
        ]
      }
    },
