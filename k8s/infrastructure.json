    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "keycloak",
        "namespace": "commerce"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "keycloak"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "keycloak"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "keycloak",
                "image": "quay.io/keycloak/keycloak:26.1.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  },
                  {
                    "containerPort": 9000
                  }
                ],
                "env": [
                  {
                    "name": "KC_BOOTSTRAP_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "commerce-local",
                        "key": "KC_BOOTSTRAP_ADMIN_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "KC_BOOTSTRAP_ADMIN_USERNAME",
                    "value": "admin"
                  },
                  {
                    "name": "KC_HEALTH_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "KC_HOSTNAME",
                    "value": "http://localhost:8181"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1Gi"
                  }
                },
                "args": [
                  "start-dev",
                  "--import-realm"
                ],
                "volumeMounts": [
                  {
                    "name": "commerce-realm",
                    "mountPath": "/opt/keycloak/data/import/commerce-realm.json",
                    "subPath": "commerce-realm.json",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/opt/keycloak/data"
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8080
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "commerce-realm",
                "configMap": {
                  "name": "commerce-realm"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "keycloak-data"
                }
              }
            ],
            "securityContext": {
              "fsGroup": 1000
            }
          }
        }
      }
    },
