        "ports": [
          {
            "name": "tcp-29092",
            "port": 29092,
            "targetPort": 29092
          },
          {
            "name": "tcp-29093",
            "port": 29093,
            "targetPort": 29093
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "commerce-realm",
        "namespace": "commerce"
      },
      "data": {
        "commerce-realm.json": "{\n  \"realm\": \"commerce\",\n  \"enabled\": true,\n  \"roles\": {\n    \"realm\": [\n      {\n        \"name\": \"admin\"\n      },\n      {\n        \"name\": \"customer\"\n      }\n    ]\n  },\n  \"clients\": [\n    {\n      \"clientId\": \"commerce-cli\",\n      \"publicClient\": true,\n      \"directAccessGrantsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"protocol\": \"openid-connect\",\n      \"protocolMappers\": [\n        {\n          \"name\": \"commerce-audience\",\n          \"protocol\": \"openid-connect\",\n          \"protocolMapper\": \"oidc-audience-mapper\",\n          \"config\": {\n            \"included.custom.audience\": \"commerce-api\",\n            \"access.token.claim\": \"true\"\n          }\n        }\n      ],\n      \"defaultClientScopes\": [\n        \"profile\",\n        \"email\",\n        \"roles\"\n      ]\n    }\n  ],\n  \"users\": [\n    {\n      \"username\": \"customer\",\n      \"enabled\": true,\n      \"email\": \"customer@example.com\",\n      \"emailVerified\": true,\n      \"firstName\": \"Demo\",\n      \"lastName\": \"Customer\",\n      \"realmRoles\": [\n        \"customer\"\n      ],\n      \"credentials\": [\n        {\n          \"type\": \"password\",\n          \"value\": \"local-customer-password\",\n          \"temporary\": false\n        }\n      ]\n    },\n    {\n      \"username\": \"catalog-admin\",\n      \"enabled\": true,\n      \"email\": \"admin@example.com\",\n      \"emailVerified\": true,\n      \"firstName\": \"Demo\",\n      \"lastName\": \"Admin\",\n      \"realmRoles\": [\n        \"admin\"\n      ],\n      \"credentials\": [\n        {\n          \"type\": \"password\",\n          \"value\": \"local-catalog-password\",\n          \"temporary\": false\n        }\n      ]\n    }\n  ]\n}"
      }
    },
    {
      "apiVersion": "v1",
